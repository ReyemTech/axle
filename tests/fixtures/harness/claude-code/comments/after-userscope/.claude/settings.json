{
   // permissions I tuned
   "permissions": { "allow": ["Bash(ls:*)"] },

   "hooks": {
      /* mail for this machine */
      "Stop": [
         { "hooks": [ { "type": "command", "command": "notify-send done" } ] },
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "{{AXL}} hook stop",
                  "timeout": 5
               }
            ]
         }
      ],
      "SessionStart": [
         { "hooks": [{ "type": "command", "command": "echo hi" }] },
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "{{AXL}} hook session-start",
                  "timeout": 5
               }
            ]
         }
      ],
      "UserPromptSubmit": [
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "{{AXL}} hook user-prompt-submit",
                  "timeout": 5
               }
            ]
         }
      ],
      "PostToolUse": [
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "{{AXL}} hook post-tool-use",
                  "timeout": 5
               }
            ]
         }
      ]
   }
}
