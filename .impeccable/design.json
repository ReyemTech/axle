      "description": "Dark bar with mark, tabs and live pulse.",
      "html": "<div class=\"ds-bar\"><span class=\"ds-brand\"><span class=\"ds-mark\"></span>coord</span><nav class=\"ds-tabs\"><a class=\"ds-on\">Board</a><a>Inbox</a><a>Projects</a></nav></div>",
      "css": ".ds-bar{display:flex;align-items:center;gap:20px;padding:0 16px;min-height:44px;background:var(--bar);color:var(--bar-text);font:14px var(--font)}.ds-brand{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:15px}.ds-mark{position:relative;width:22px;height:2px;background:currentColor}.ds-mark::after{content:'';position:absolute;left:7px;top:-3px;width:8px;height:8px;background:var(--sig-red)}.ds-tabs{display:flex;align-self:stretch}.ds-tabs a{display:flex;align-items:center;padding:0 10px;color:var(--bar-muted);border-bottom:2px solid transparent}.ds-tabs a.ds-on{color:var(--bar-text);font-weight:600;border-bottom-color:var(--bar-text)}"
    }
  ],
  "narrative": {
    "northStar": "Block Signalling",
    "overview": "coord reads like a railway signal box: projects are lines, tasks are blocks, a lease is the occupancy of a block, and a few signal aspects say what state each block is in. The first build was pure hairlines and read as too minimal; the shipped system adds column bands, bordered cards, labelled buttons and a text label beside every glyph, while keeping density.",
    "keyCharacteristics": [
      "Neutral warm-paper ground and graphite ink; saturated colour only for state and project lines.",
      "Three signal hues, each with a text-safe twin.",
      "Flat: no shadows; tonal depth plus 1px borders.",
      "Tabular numerals; monospace for agent ids and leases.",
      "System font stack only.",
      "Light and dark themes via prefers-color-scheme."
    ],
    "rules": [
      {
        "name": "The Signal Is State Rule",
        "body": "Red, green and amber appear only to report state; never decoration or branding.",
        "section": "colors"
      },
      {
        "name": "The Line Is Identity Rule",
        "body": "Project line colours mark which project something belongs to, never state, never card fills.",
        "section": "colors"
      },
      {
        "name": "The Never Glyph Or Colour Alone Rule",
        "body": "Every state glyph or hue is paired with a visible text label next to it.",
        "section": "colors"
      },
      {
        "name": "The Mono Means Machine Rule",
        "body": "Monospace is for agent-produced identifiers; prose stays in the sans.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numerals are tabular so live counts and lease times do not jitter.",
        "section": "typography"
      },
      {
        "name": "The Flat Always Rule",
        "body": "No box-shadow; separation comes from tone and 1px borders.",
        "section": "elevation"
      },
      {
        "name": "The Selected Is An Outline Rule",
        "body": "Keyboard selection and focus are a 2px outline, never a fill.",
        "section": "elevation"
      },
      {
        "name": "The Shape Carries State Rule",
        "body": "Ring open, half claimed, square blocked, ringed centre review, solid done or live, slash cancelled; do not reuse for other meaning.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do pair every signal glyph or state hue with a text label right beside it.",
      "Do keep red, green and amber for state, and use the text-safe twins for type.",
      "Do colour a project's track rule or swatch with its line colour, consistently across surfaces.",
      "Do surface tasks as bordered cards on column bands, 6px radius, no shadows.",
      "Do label every button with a verb; ink for primary, bordered for secondary, soft red for destructive.",
      "Do use tabular numerals and mono for agent ids and lease times.",
      "Do make the blocked and review columns louder only when they hold work.",
      "Do define colours as tokens on :root with a dark prefers-color-scheme override; add new roles to both."
    ],
    "donts": [
      "Don't convey state by glyph or colour alone; a lone dot is a bug.",
      "Don't use box-shadow, gradient glows or a decorative accent hue.",
      "Don't use project line colours to mean status, or signal colours to mean project.",
      "Don't add icon-only buttons or external fonts, scripts, styles or images.",
      "Don't nest cards inside cards.",
      "Don't add chrome, extra clicks or padding that reduces how much state fits on screen.",
      "Don't dress it as a terminal or a generic SaaS dashboard."
    ]
  }
}