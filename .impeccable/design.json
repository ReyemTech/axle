  "components": [
    {
      "name": "Task Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Bordered card on a column band with state glyph plus word, project line swatch, owner and lease meter.",
      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-title\">Rotate staging credentials</h3><div class=\"ds-meta\"><span class=\"ds-state\"><span class=\"ds-aspect\"></span>claimed</span><span class=\"ds-project\">iac</span></div><div class=\"ds-owner\">Held by <span class=\"ds-mono\">iac/mac/claude</span> <span class=\"ds-live\">live</span></div><div class=\"ds-lease\"><span class=\"ds-lease-text\">lease 12m</span><span class=\"ds-track\"><span class=\"ds-occ\"></span></span></div></article>",
      "css": ".ds-card{display:grid;gap:5px;padding:10px 12px;background:var(--card);border:1px solid var(--card-border);border-radius:6px;font:14px/1.45 var(--font);color:var(--text)}.ds-card:hover{border-color:var(--rule-strong)}.ds-card-title{margin:0;font-size:14px;font-weight:600;line-height:1.35}.ds-meta{display:flex;gap:12px;align-items:center;font-size:12.5px;color:var(--muted)}.ds-state{display:inline-flex;gap:5px;align-items:center;font-weight:600;color:var(--text)}.ds-aspect{width:10px;height:10px;border-radius:50%;border:1.5px solid var(--sig-red);background:linear-gradient(90deg,var(--sig-red) 50%,transparent 50%)}.ds-project::before{content:'';display:inline-block;width:10px;height:3px;margin-right:5px;background:var(--line-1);vertical-align:middle}.ds-owner{font-size:12.5px;color:var(--muted)}.ds-mono{font:12px var(--mono);color:var(--text)}.ds-live{font-size:12px;font-weight:600;color:var(--ok)}.ds-lease{display:flex;gap:10px;align-items:center}.ds-lease-text{font-size:12px;color:var(--muted)}.ds-track{position:relative;flex:1;height:2px;background:var(--line-1)}.ds-occ{position:absolute;left:0;top:-3px;height:8px;width:70%;background:var(--sig-red)}"
    },
    {
      "name": "Blocked Card",
      "kind": "card",
      "refersTo": "card-blocked",
      "description": "Soft red wash with square glyph and the word blocked.",
      "html": "<article class=\"ds-card ds-blocked\"><h3 class=\"ds-card-title\">Waiting on DNS change</h3><div class=\"ds-meta\"><span class=\"ds-state\"><span class=\"ds-sq\"></span>blocked</span></div></article>",
      "css": ".ds-card{display:grid;gap:5px;padding:10px 12px;background:var(--card);border:1px solid var(--card-border);border-radius:6px;font:14px/1.45 var(--font);color:var(--text)}.ds-blocked{background:var(--danger-soft);border-color:var(--danger-border)}.ds-card-title{margin:0;font-size:14px;font-weight:600}.ds-meta{font-size:12.5px}.ds-state{display:inline-flex;gap:5px;align-items:center;font-weight:600;color:var(--danger)}.ds-sq{width:10px;height:10px;border-radius:1px;background:var(--sig-red);border:1.5px solid var(--sig-red)}"
    },
    {
      "name": "Column Head",
      "kind": "custom",
      "refersTo": "column-head",
      "description": "Band header with aspect glyph, uppercase label and count; count grows when blocked holds work.",
      "html": "<div class=\"ds-col\"><header class=\"ds-head\"><span class=\"ds-sq\"></span><h2>Blocked</h2><span class=\"ds-count\">2</span></header></div>",
      "css": ".ds-col{background:var(--band);border-radius:6px;font:14px var(--font);color:var(--text)}.ds-head{display:flex;align-items:center;gap:8px;height:40px;padding:0 12px;border-bottom:2px solid var(--text)}.ds-head h2{margin:0;font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.ds-sq{width:14px;height:14px;border-radius:1px;background:var(--sig-red)}.ds-count{margin-left:auto;font-size:18px;font-weight:700;color:var(--danger)}"
    },
