{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "database"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "coord runs as a single replica in the MVP"
    },
    "database": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["sqlite", "postgres"] },
        "existingSecret": { "type": "string" },
        "urlKey": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "mode": { "const": "postgres" } } },
      "then": {
        "required": ["existingSecret"],
        "properties": { "existingSecret": { "type": "string", "minLength": 1 } }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "adminSecret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "cookieSecure": { "type": ["boolean", "null"] },
    "trustedHeader": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "extraEnv": { "type": "array" }
  }
}
