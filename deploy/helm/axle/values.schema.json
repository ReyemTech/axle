{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "database",
    "ui"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "Axle runs as a single replica in the MVP"
    },
    "database": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "sqlite",
            "postgres"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "postgres"
          }
        }
      },
      "then": {
        "required": [
          "existingSecret"
        ],
        "properties": {
          "existingSecret": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "secret",
                "none",
                "trustedHeader"
              ],
              "description": "How a human signs in to the web UI"
            },
            "secret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "description": "Empty, or at least 16 characters (checked at render time)"
                }
              }
            },
            "trustedHeader": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "trustedHeader"
              }
            }
          },
          "then": {
            "required": [
              "trustedHeader"
            ],
            "properties": {
              "trustedHeader": {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  }
                }
              }
            }
          }
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cookieSecure": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 10
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "publicUrl": {
      "type": "string"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "adminSecret": {
      "not": {},
      "description": "moved to ui.auth.secret"
    },
    "trustedHeader": {
      "not": {},
      "description": "moved to ui.auth.trustedHeader.name"
    },
    "cookieSecure": {
      "not": {},
      "description": "moved to ui.cookieSecure"
    }
  }
}
